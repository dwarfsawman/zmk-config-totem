#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ── Maya レイヤ群 (6〜10) ─────────────────────────────────────────
 * 既存レイヤ 0〜5 はそのまま。番号参照 (&ltt 4 I, stop-layer=<4> 等) を
 * 壊さないよう末尾に追加している。
 * MIR は NUM/NAV/FN より下に置く (MIR トグル中も親指ホールドが効くように)。
 *
 * 切替:  通常 → Maya : A/S/D 位置 (10 11 12) の3キー同時押し  (&to MAYA)
 *        Maya → 通常 : 同じ3キー同時押し、または FN 外側小指  (&to 0  … MIR も同時に解除)
 *        Maya 内 MIR : Z X C (21 22 23) の3キー同時押し        (&tog MIR)
 * ───────────────────────────────────────────────────────────────── */

#define MAYA 6
#define MIR  7
#define NUM  8
#define NAV  9
#define FN   10

/* 通常モードのレイヤ一覧 (既存コンボのスコープ用) */

#define NORMAL_LAYERS 0 1 2 3 4 5
#define MAYA_LAYERS   MAYA MIR NUM NAV FN

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod L";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod R";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
        };

        /* Maya 用 片手 HRM: 反対側の手が無いので hold-trigger-key-positions 無し。
         * quick-tap で「タップ→即長押し」すると素のキー長押し (D 長押しピボット等) */

        hmo: home_row_mod_onehand {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod 1H";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        ltt: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer-Tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        bt0: bt_profile_0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Bluetooth Profile 0";
            #binding-cells = <0>;
            bindings = <&macro_bt0>, <&bt BT_CLR>;
        };

        bt1: bt_profile_1 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Bluetooth Profile 1";
            #binding-cells = <0>;
            bindings = <&macro_bt1>, <&bt BT_CLR>;
        };

        bt2: bt_profile_2 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Bluetooth Profile 2";
            #binding-cells = <0>;
            bindings = <&macro_bt2>, <&bt BT_CLR>;
        };

        sqtundr: shift_squote_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp UNDER>;

            mods = <(MOD_LSFT)>;
        };

        dotcolon: shift_dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;

            mods = <(MOD_LSFT)>;
        };

        mindqt: shift_minus_dquote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp DQT>;

            mods = <(MOD_LSFT)>;
        };

        commsemi: shift_comma_semicolon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;

            mods = <(MOD_LSFT)>;
        };

        lmt: layer_mouse_thumb {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer-Tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&mkp>;

            label = "LAYER_MOUSE_THUMB";
        };

        rpinky_i_ctrl: rpinky_i_ctrl {
            compatible = "zmk,behavior-mod-morph";
            label = "RPINKY_I_CTRL";
            bindings = <&ltt 4 I>, <&kp LEFT_CONTROL>;

            #binding-cells = <0>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RSFT|MOD_RALT|MOD_RGUI)>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RGUI|MOD_RSFT|MOD_RALT)>;
        };

        gmmv: gated_mouse_move {
            compatible = "zmk,behavior-gated-mouse-move";
            #binding-cells = <1>;
            bindings = <&mmv>;
            stop-layer = <4>;
            display-name = "Gated Mouse Move";
        };
    };

    macros {
        macro_bt0: bt_profile_0_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        macro_bt1: bt_profile_1_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        macro_bt2: bt_profile_2_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        win_Shift: win_Shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LEFT_GUI &sk LEFT_SHIFT>;
            label = "WIN_SHIFT";
        };

        ime_toggle_hybrid: ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp GLOBE>,
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "IME_TOGGLE";
        };

        alt_funcfour: alt_funcfour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(F4)>;
            label = "ALT_FUNCFOUR";
        };

        ctrl_c: ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>;
            label = "CTRL_C";
        };

        ctrl_v: ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
            label = "CTRL_V";
        };

        ctrl_x: ctrl_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>;
            label = "CTRL_X";
        };

        win_ctrl: win_ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LEFT_GUI &sk LCTRL>;
            label = "WIN_CTRL";
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ───── 既存 (通常モード) ─────
         * layers 未指定だったものには NORMAL_LAYERS を付けて Maya 側に漏れないようにした。
         * 通常モードでの挙動は変わらない。 */

        combo_tab {
            timeout-ms = <30>;
            require-prior-idle-ms = <175>;
            key-positions = <1 2>; // LD
            layers = <0>;
            bindings = <&kp TAB>;
        };

        combo_spc_lower {
            timeout-ms = <30>;
            key-positions = <1 2>;
            layers = <1>;
            bindings = <&kp SPACE>;
        };

        combo_del {
            timeout-ms = <30>;
            key-positions = <22 23>; // XM
            layers = <0>;
            bindings = <&kp DEL>;
        };

        combo_bspc_upper {
            timeout-ms = <30>;
            key-positions = <7 8>; // OU
            layers = <2>;
            bindings = <&kp BSPC>;
        };

        combo_ime_toggle {
            timeout-ms = <30>;
            key-positions = <13 12>; // SH
            layers = <0>;
            bindings = <&ime_toggle_hybrid>;
        };

        combo_caps_word {
            bindings = <&kp CAPSLOCK>;
            key-positions = <14 13 15>;
        };

        close_window {
            bindings = <&alt_funcfour>;
            key-positions = <11 12 13>;
            slow-release;
            timeout-ms = <30>;
            layers = <4>;
        };

        application {
            bindings = <&kp K_APP>;
            key-positions = <13 11>;
            timeout-ms = <60>;
            layers = <0>;
        };

        terminal_toggle {
            bindings = <&kp F13>;
            key-positions = <24 23>;
        };

        toggle_agentpanel {
            bindings = <&kp F14>;
            key-positions = <0 1>;
        };

        toggle_projectpanel {
            bindings = <&kp F15>;
            key-positions = <3 4>;
        };

        insert {
            bindings = <&kp INSERT>;
            key-positions = <16 17>;
        };

        /* ───── モード切替 (ホームロウ 小指+薬指+中指 の3キー同時押し) ───── */

        maya_on {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <10 11 12>; // 通常: N R T
            layers = <0>;
            bindings = <&to 5>;
        };

        maya_off {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <10 11 12>; // Maya: A S D
            layers = <5 6>;
            bindings = <&to 0>;         // &to 0 で MIR 等の残留トグルも一括解除
        };

        /* ───── Maya 内 ───── */

        maya_mir_tog {
            timeout-ms = <50>;
            key-positions = <21 22 23>; // Z X C (MIR 中は / . ,)
            layers = <5 6>;
            bindings = <&tog 6>;
        };

        /* 人差し指+中指 (同列) */

        bindings = <&kp INS>;
    }; // D+F  Insert bindings = <&kp DEL>;  }; // E+R  Delete
    maya_h {
        timeout-ms = <40>;
        key-positions = <23 24>;
        layers = <5 6>;
        bindings = <&kp H>;
    }; // C+V  H
    /* 中指+薬指 */

    bindings = <&kp TAB>;
}; // W+E  Tab bindings = <&kp BSPC>; }; // X+C  Backspace
/* 人差し指2キー */

maya_p {
    timeout-ms = <40>;
    key-positions = <24 25>;
    layers = <5 6>;
    bindings = <&kp P>;
}; // V+B  P
};

conditional_layers {
    compatible = "zmk,conditional-layers";

    /* Maya: NUM + NAV 親指同時ホールド → FN */

    maya_fn_tri {
        if-layers = <7 8>;
        then-layer = <9>;
    };
};

keymap {
    compatible = "zmk,keymap";

    /* Base (default), Graphite alphas
         */

    base_layer {
        display-name = "Base";
        bindings = <
         &kp B         &kp L              &kp D            &kp W            &kp Z            &sqtundr      &kp F             &kp O             &kp U               &kp J
         &hml LCTRL N  &hml LEFT_SHIFT R  &hml LEFT_ALT T  &hml LEFT_GUI S  &kp G            &kp Y         &hmr RIGHT_GUI H  &hmr RIGHT_ALT A  &hmr RIGHT_SHIFT E  &rpinky_i_ctrl
&kp ESC  &kp Q         &kp X              &kp M            &kp C            &kp V            &kp K         &kp P             &dotcolon         &mindqt             &commsemi       &hmr RCTRL TAB
                                          &kp DELETE       &ltt 2 SPACE     &kp BACKSPACE    &ltt 1 ENTER  &lmt 1 MB1        &lmt 3 MB2
        >;
    };

    /* Numbers, Navigation
         */

    lower_layer {
        display-name = "Lower";
        bindings = <
           &kp KP_MINUS  &kp N7  &kp N8  &kp N9  &kp KP_PLUS        &kp PRCNT  &kp UP_ARROW   &kp LPAR              &kp RPAR               &kp KP_DOT
           &kp N0        &kp N4  &kp N5  &kp N6  &kp EQUAL          &kp LEFT   &kp RIGHT_GUI  &hmr RIGHT_ALT RIGHT  &hmr RIGHT_SHIFT LBKT  &hmr RCTRL RBKT
&kp COLON  &kp KP_SLASH  &kp N1  &kp N2  &kp N3  &kp KP_ASTERISK    &kp HOME   &kp PG_DN      &dotcolon             &kp END                &kp X            &kp B
                                 &trans  &trans  &trans             &none      &trans         &trans
        >;
    };

    /* Symbols
         */

    upper_layer {
        display-name = "Upper";
        bindings = <
           &kp TILDE      &kp DOT          &kp ASTRK            &kp AMPS          &kp AT      &kp PRCNT  &kp LBKT          &kp LPAR        &kp RPAR               &kp RBKT
           &hml LCTRL LT  &hml LSHFT PIPE  &hml LEFT_ALT MINUS  &hmr LEFT_GUI GT  &kp FSLH    &kp EXCL   &hmr RMETA COMMA  &hmr RALT LBRC  &hmr RIGHT_SHIFT RBRC  &hmr RCTRL SEMI
&kp UNDER  &kp GRAVE      &kp SQT          &kp DQT              &kp PLUS          &kp BSLH    &kp HASH   &kp CARET         &kp COLON       &kp EQUAL              &kp DLLR         &kp QMARK
                                           &trans               &trans            &none       &trans     &trans            &trans
        >;
    };

    /* Media, Mouse, Keyboard control
         */

    adjust_layer {
        display-name = "Adjust";
        bindings = <
            &kp F1        &kp F2        &kp F3    &kp F4    &kp F5        &kp F6          &kp F7          &kp F8           &kp F9           &kp F10
            &kp LEFT_ALT  &to 5         &mkp MB2  &mkp MB1  &bt BT_CLR    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none            &kp F11
&kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &bt0      &bt1      &bt2          &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP     &msc SCRL_RIGHT  &kp F13  &kp F12
                                        &none     &none     &none         &none           &none           &none
        >;
    };

    layer_4 {
        display-name = "layer4";
        bindings = <
              &kp LEFT_WIN      &mkp MB2         &gmmv MOVE_UP     &mkp MB1          &none              &none           &kp HOME        &kp UP          &kp END          &none
              &kp LEFT_CONTROL  &gmmv MOVE_LEFT  &gmmv MOVE_DOWN   &gmmv MOVE_RIGHT  &msc SCRL_RIGHT    &none           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT        &none
&kp LEFT_ALT  &kp C_VOL_DN      &kp C_VOL_UP     &msc SCRL_LEFT    &msc SCRL_DOWN    &msc SCRL_UP       &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT  &none  &none
                                                 &kp LEFT_CONTROL  &kp LEFT_ALT      &kp LEFT_SHIFT     &mkp RCLK       &mkp LCLK       &mkp MCLK
        >;
    };

    /* ══════════════════ Maya 2026 左手デバイス ══════════════════
         * 右半分は全て &trans (接続していれば Graphite のまま使える)
         */

    maya_layer {
        display-name = "Maya";

        // ┌───────┬───────┬───────┬───────┬───────┐
        // │   Q   │   W   │   E   │   R   │   T   │
        // ├───────┼───────┼───────┼───────┼───────┤
        // │ A/Ctl │ S/Sft │ D/Alt │ F/Win │   G   │
        // ├───────┼───────┼───────┼───────┼───────┼───────┐
        // │  Alt  │   Z   │   X   │   C   │   V   │   B   │
        // └───────┴───────┴───────┼───────┼───────┼───────┤
        //                         │Esc/NAV│Ent/NUM│ Space │
        //                         └───────┴───────┴───────┘

        bindings = <
          &kp Q         &kp W         &kp E        &kp R        &kp T        &trans  &trans  &trans  &trans  &trans
          &hmo LCTRL A  &hmo LSHFT S  &hmo LALT D  &hmo LGUI F  &kp G        &trans  &trans  &trans  &trans  &trans
&kp LALT  &kp Z         &kp X         &kp C        &kp V        &kp B        &trans  &trans  &trans  &trans  &trans  &trans
                                      &ltt 8 ESC   &ltt 7 RET   &kp SPACE    &trans  &trans  &trans
        >;
    };

    maya_mirror_layer {
        display-name = "Maya Mirror";

        // 右手側を鏡写し (名前入力・右側ホットキー用)。Z X C 同時押しでトグル
        // ┌───────┬───────┬───────┬───────┬───────┐
        // │   P   │   O   │   I   │   U   │   Y   │
        // ├───────┼───────┼───────┼───────┼───────┤
        // │ ;/Ctl │ L/Sft │ K/Alt │ J/Win │   H   │
        // ├───────┼───────┼───────┼───────┼───────┼───────┐
        // │   '   │   /   │   .   │   ,   │   M   │   N   │
        // └───────┴───────┴───────┼───────┼───────┼───────┤
        //                         │  ---  │  ---  │  ---  │
        //                         └───────┴───────┴───────┘

        bindings = <
         &kp P            &kp O         &kp I        &kp U        &kp Y     &trans  &trans  &trans  &trans  &trans
         &hmo LCTRL SEMI  &hmo LSHFT L  &hmo LALT K  &hmo LGUI J  &kp H     &trans  &trans  &trans  &trans  &trans
&kp SQT  &kp FSLH         &kp DOT       &kp COMMA    &kp M        &kp N     &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans       &trans       &trans    &trans  &trans  &trans
        >;
    };

    maya_num_layer {
        display-name = "Maya Num";

        // ┌───────┬───────┬───────┬───────┬───────┐
        // │   1   │   2   │   3   │   4   │   5   │
        // ├───────┼───────┼───────┼───────┼───────┤
        // │   6   │   7   │   8   │   9   │   0   │
        // ├───────┼───────┼───────┼───────┼───────┼───────┐
        // │  F1   │  F8   │  F9   │  F10  │  F11  │  F12  │
        // └───────┴───────┴───────┼───────┼───────┼───────┤
        //                         │  ---  │ (held)│  ---  │
        //                         └───────┴───────┴───────┘

        bindings = <
        &kp N1  &kp N2  &kp N3   &kp N4   &kp N5     &trans  &trans  &trans  &trans  &trans
        &kp N6  &kp N7  &kp N8   &kp N9   &kp N0     &trans  &trans  &trans  &trans  &trans
&kp F1  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans   &trans   &trans     &trans  &trans  &trans
        >;
    };

    maya_nav_layer {
        display-name = "Maya Nav";

        // ┌───────┬───────┬───────┬───────┬───────┐
        // │ PgUp  │   [   │   ↑   │   ]   │ PgDn  │
        // ├───────┼───────┼───────┼───────┼───────┤
        // │ Home  │   ←   │   ↓   │   →   │  End  │
        // ├───────┼───────┼───────┼───────┼───────┼───────┐
        // │   `   │   -   │   =   │   ,   │   .   │   /   │
        // └───────┴───────┴───────┼───────┼───────┼───────┤
        //                         │ (held)│  ---  │  ---  │
        //                         └───────┴───────┴───────┘

        bindings = <
           &kp PG_UP  &kp LBKT   &kp UP     &kp RBKT   &kp PG_DN    &trans  &trans  &trans  &trans  &trans
           &kp HOME   &kp LEFT   &kp DOWN   &kp RIGHT  &kp END      &trans  &trans  &trans  &trans  &trans
&kp GRAVE  &kp MINUS  &kp EQUAL  &kp COMMA  &kp DOT    &kp FSLH     &trans  &trans  &trans  &trans  &trans  &trans
                                 &trans     &trans     &trans       &trans  &trans  &trans
        >;
    };

    maya_fn_layer {
        display-name = "Maya Fn";

        // NUM + NAV 親指同時ホールド
        // ┌───────┬───────┬───────┬───────┬───────┐
        // │  F1   │  F2   │  F3   │  F4   │  F5   │
        // ├───────┼───────┼───────┼───────┼───────┤
        // │  F6   │  F7   │  F8   │  F9   │  F10  │
        // ├───────┼───────┼───────┼───────┼───────┼───────┐
        // │ EXIT  │  F11  │  F12  │  BT0  │  BT1  │  BT2  │
        // └───────┴───────┴───────┼───────┼───────┼───────┤
        //                         │ (held)│ (held)│  ---  │
        //                         └───────┴───────┴───────┘

        bindings = <
       &kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &trans  &trans  &trans  &trans  &trans
       &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &trans  &trans  &trans  &trans  &trans
&to 0  &kp F11  &kp F12  &bt0    &bt1    &bt2       &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &trans     &trans  &trans  &trans
        >;
    };
};

};
